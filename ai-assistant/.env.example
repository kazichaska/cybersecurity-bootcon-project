# Copy to .env in this directory to override defaults.
# Values here also work as plain shell exports before `python labctl.py ai --up`.

# --- Provider selection ---
# "ollama" (default, local/free) or "openai" (production, requires OPENAI_API_KEY)
AI_PROVIDER=ollama

# --- Local Ollama backend ---
# 11435, not Ollama's standard 11434, since that's commonly already taken
# by another local Ollama install.
OLLAMA_PORT=11435
# Tiny model (~400MB) chosen for stability in a default Colima VM (4GB RAM)
# shared with the rest of the lab (bwapp_web alone has been observed using
# ~1.7GB). Even llama3.2:1b (~1.3GB) intermittently crashed the model
# runner (502s) under that contention. Quality is quite limited at this
# size. If you have more RAM available (bump Colima with
# `colima start --memory 8`, restarts all containers on the VM), try a
# stronger model, e.g.:
#   OLLAMA_MODEL=llama3.2:1b   (needs ~1.3GB free — still tight on 4GB VMs)
#   OLLAMA_MODEL=llama3.2:3b   (needs ~2.5GB free)
#   OLLAMA_MODEL=llama3.1:8b   (needs ~6GB free)
OLLAMA_MODEL=qwen2.5:0.5b

# --- OpenAI backend (used once AI_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- ai-backend web service ---
AI_BACKEND_PORT=8700
